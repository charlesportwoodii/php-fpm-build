#!/usr/bin/env python3
"""Derive VERSION, RELEASEVER and SHORT_VERSION from a release version.

The version is supplied by the release workflow. There is deliberately no
DEFAULT_VERSION fallback: it used to be duplicated across five Drone
pipelines and drifted eight patch releases out of date.
"""

import argparse
import os
import sys

import semver

ENV_ORDER = ("VERSION", "RELEASEVER", "SHORT_VERSION")


def compute_env(version):
    """Map a release version such as '8.5.9-1' to its build variables.

    The semver prerelease field carries the package revision. A version
    given without one is treated as revision 1.
    """
    if not version:
        raise ValueError("version is required")
    try:
        parsed = semver.Version.parse(version)
    except ValueError as exc:
        raise ValueError("invalid version {!r}: {}".format(version, exc)) from exc

    return {
        "VERSION": "{}.{}.{}".format(parsed.major, parsed.minor, parsed.patch),
        "RELEASEVER": parsed.prerelease if parsed.prerelease else "1",
        "SHORT_VERSION": "{}.{}".format(parsed.major, parsed.minor),
    }


def write_envs(version, path=".envs"):
    """Write the .envs file the Makefile includes at line 3.

    Line order is load-bearing: `head -n1` must be VERSION and `tail -n1`
    must be SHORT_VERSION.
    """
    env = compute_env(version)
    with open(path, "w") as handle:
        for key in ENV_ORDER:
            handle.write("{}={}\n".format(key, env[key]))
    return env


def main():
    parser = argparse.ArgumentParser(
        description="Generate the .envs file for the build"
    )
    parser.add_argument(
        "version",
        nargs="?",
        default=os.getenv("RELEASE_VERSION"),
        help="Release version, e.g. 8.5.9-1. Defaults to $RELEASE_VERSION.",
    )
    parser.add_argument("--output", default=".envs")
    args = parser.parse_args()

    try:
        env = write_envs(args.version, args.output)
    except ValueError as exc:
        print("error: {}".format(exc), file=sys.stderr)
        return 1

    print(env)
    return 0


if __name__ == "__main__":
    sys.exit(main())
